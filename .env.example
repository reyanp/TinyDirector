# Copy to .env (gitignored) and fill in. Real environment variables win over this file.

# Model API key from https://build.nvidia.com  (starts with nvapi-, NOT the Brev bak- key)
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Optional overrides
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# 0 = fast direct JSON (default), 1 = reasoning on (slower, more tokens)
NEMOTRON_THINKING=0
NEMOTRON_TIMEOUT=90

# ---- Lesson builder agent (multi-agent lessons: director/lesson/) ----
# OpenAI key for the BUILDER agent, which writes Blender code against blender_engine/toolkit.py.
# Leave empty to use the deterministic (non-LLM) builder; output is then labeled accordingly.
OPENAI_API_KEY=
# Model the builder uses (any chat-completions model your key can access)
OPENAI_BUILDER_MODEL=gpt-5
# Optional: OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=180
